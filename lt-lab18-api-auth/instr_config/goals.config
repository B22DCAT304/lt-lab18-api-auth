api_server_healthy = boolean : (_health)
#DOC api_server_healthy : API server responds to health checks.
missing_token_rejected = boolean : (_missing)
#DOC missing_token_rejected : Missing token returns HTTP 401.
invalid_token_rejected = boolean : (_invalid)
#DOC invalid_token_rejected : Invalid token returns HTTP 401.
valid_user_authenticated = boolean : (_user)
#DOC valid_user_authenticated : User token allows profile access.
user_admin_access_denied = boolean : (_forbidden)
#DOC user_admin_access_denied : User cannot access admin API.
admin_access_allowed = boolean : (_admin)
#DOC admin_access_allowed : Admin token allows admin API access.
authorization_denial_logged = boolean : (_audit)
#DOC authorization_denial_logged : Server logs forbidden access.
