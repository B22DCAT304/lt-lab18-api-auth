#!/usr/bin/python3
from http.server import HTTPServer, BaseHTTPRequestHandler
from pathlib import Path
import hmac

PORT = 8081
LOG = Path("/home/ubuntu/lab18/events.log")

TOKENS = {
    "user": "lab18-user-demo",
    "admin": "lab18-admin-demo"
}

class Handler(BaseHTTPRequestHandler):
    def reply(self, status, message):
        data = (message + "\n").encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(data)))
        if status == 401:
            self.send_header("WWW-Authenticate", "Bearer")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/health":
            self.reply(200, "LAB18_API_HEALTHY")
            return

        if self.path not in ("/profile", "/admin"):
            self.reply(404, "NOT_FOUND")
            return

        auth = self.headers.get("Authorization", "")
        role = None

        if auth.startswith("Bearer "):
            token = auth[7:]
            for name, expected in TOKENS.items():
                if hmac.compare_digest(token, expected):
                    role = name
                    break

        if role is None:
            status = 401
            message = "LAB18_UNAUTHORIZED"
        elif self.path == "/admin" and role != "admin":
            status = 403
            message = "LAB18_FORBIDDEN"
        else:
            status = 200
            message = "LAB18_ADMIN_OK" if self.path == "/admin" else "LAB18_PROFILE_OK"

        event = "DENIED" if status in (401, 403) else "ALLOWED"
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open("a") as f:
            f.write(
                f"LAB18_EVENT={event} status={status} "
                f"role={role or 'none'} "
                f"path={self.path} src_ip={self.client_address[0]}\n"
            )

        self.reply(status, message)

    def log_message(self, *args):
        pass

HTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
